{
  "port": 8103,
  "maxJsonSize": "1mb",
  "maxBatchSize": "50mb",
  "vmContextBotsEnabled": true,
  "defaultBotRuntimeVersion": "vmcontext",
  "botLambdaRoleArn": "",
  "botLambdaLayerName": "medplum-bot-layer",
  "emailProvider": "awsses",
  "awsRegion": "us-east-1",
  "introspectionEnabled": true,
  "registerEnabled": true,
  "allowedOrigins": "*",
  "logLevel": "info",
  "logAuditEvents": true,
  "saveAuditEvents": true,
  "shutdownTimeoutMilliseconds": 30000,
  "bullmq": {
    "concurrency": 20,
    "removeOnFail": { "count": 100 },
    "removeOnComplete": { "count": 100 }
  },
  "database": {
    "ssl": {
      "require": true,
      "rejectUnauthorized": false
    },
    "disableConnectionConfiguration": true,
    "runMigrations": true
  }
}
