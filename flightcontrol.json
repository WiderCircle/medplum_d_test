{
  "$schema": "https://app.flightcontrol.dev/schema.json",
  "environments": [
    {
      "id": "production",
      "name": "Production",
      "region": "us-east-1",
      "source": {
        "branch": "main"
      },
      "services": [
        {
          "id": "db",
          "type": "rds",
          "name": "Medplum Postgres",
          "engine": "postgres",
          "engineVersion": "16",
          "instanceSize": "db.t4g.medium",
          "storage": 20,
          "multiAvailabilityZones": false,
          "dbName": "medplum"
        },
        {
          "id": "redis",
          "type": "elasticache",
          "name": "Medplum Redis",
          "engine": "redis",
          "engineVersion": "7.1",
          "instanceSize": "cache.t4g.micro"
        },
        {
          "id": "storage",
          "type": "s3",
          "name": "Medplum Binary Storage",
          "bucketNameBase": "medplum-binary-prod",
          "bucketVersioning": true,
          "blockAllPublicAccess": true
        },
        {
          "id": "server",
          "type": "fargate",
          "name": "Medplum Server",
          "buildType": "docker",
          "dockerfilePath": "Dockerfile.server",
          "cpu": 1,
          "memory": 2,
          "port": 8103,
          "healthCheckPath": "/healthcheck",
          "minInstances": 1,
          "maxInstances": 3,
          "envVariables": {
            "MEDPLUM_PORT": "8103",
            "MEDPLUM_BASE_URL": "https://api.YOURDOMAIN.com/",
            "MEDPLUM_APP_BASE_URL": "https://app.YOURDOMAIN.com/",
            "MEDPLUM_STORAGE_BASE_URL": "https://api.YOURDOMAIN.com/storage/",

            "MEDPLUM_DATABASE_HOST": { "fromService": { "id": "db", "value": "host" } },
            "MEDPLUM_DATABASE_PORT": { "fromService": { "id": "db", "value": "port" } },
            "MEDPLUM_DATABASE_DBNAME": { "fromService": { "id": "db", "value": "dbName" } },
            "MEDPLUM_DATABASE_USERNAME": { "fromService": { "id": "db", "value": "username" } },
            "MEDPLUM_DATABASE_PASSWORD": { "fromService": { "id": "db", "value": "password" } },
            "MEDPLUM_DATABASE_SSL": "{\"require\":true,\"rejectUnauthorized\":false}",

            "MEDPLUM_REDIS_HOST": { "fromService": { "id": "redis", "value": "host" } },
            "MEDPLUM_REDIS_PORT": { "fromService": { "id": "redis", "value": "port" } },
            "MEDPLUM_REDIS_PASSWORD": { "fromService": { "id": "redis", "value": "authToken" } },

            "MEDPLUM_BINARY_STORAGE": "s3://${{ services.storage.bucketName }}/binary/",
            "MEDPLUM_SUPPORT_EMAIL": "\"Medplum\" <support@YOURDOMAIN.com>",
            "MEDPLUM_MAX_JSON_SIZE": "1mb",
            "MEDPLUM_MAX_BATCH_SIZE": "50mb",
            "MEDPLUM_VM_CONTEXT_BOTS_ENABLED": "true",
            "MEDPLUM_DEFAULT_BOT_RUNTIME_VERSION": "vmcontext",
            "MEDPLUM_ALLOWED_ORIGINS": "*",
            "MEDPLUM_INTROSPECTION_ENABLED": "true",
            "MEDPLUM_SHUTDOWN_TIMEOUT_MILLISECONDS": "30000",
            "MEDPLUM_GOOGLE_CLIENT_ID": "${{ secrets.GOOGLE_CLIENT_ID }}",
            "MEDPLUM_GOOGLE_CLIENT_SECRET": "${{ secrets.GOOGLE_CLIENT_SECRET }}",
            "MEDPLUM_RECAPTCHA_SITE_KEY": "${{ secrets.RECAPTCHA_SITE_KEY }}",
            "MEDPLUM_RECAPTCHA_SECRET_KEY": "${{ secrets.RECAPTCHA_SECRET_KEY }}"
          }
        },
        {
          "id": "app",
          "type": "fargate",
          "name": "Medplum App",
          "buildType": "docker",
          "dockerfilePath": "Dockerfile.app",
          "cpu": 0.5,
          "memory": 1,
          "port": 3000,
          "healthCheckPath": "/",
          "minInstances": 1,
          "maxInstances": 2,
          "envVariables": {
            "MEDPLUM_BASE_URL": "https://api.YOURDOMAIN.com/",
            "MEDPLUM_REGISTER_ENABLED": "true",
            "MEDPLUM_AWS_TEXTRACT_ENABLED": "true",
            "MEDPLUM_CLIENT_ID": "",
            "GOOGLE_CLIENT_ID": "${{ secrets.GOOGLE_CLIENT_ID }}",
            "RECAPTCHA_SITE_KEY": "${{ secrets.RECAPTCHA_SITE_KEY }}"
          }
        }
      ]
    }
  ]
}
